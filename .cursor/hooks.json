{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/wrap-hang-prone-shell.ps1",
        "matcher": "Shell",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/report-shell-timeout.ps1",
        "matcher": "Shell",
        "timeout": 10
      }
    ]
  }
}
