<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NuclearOption.ScenarioEditor</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NuclearOption.ScenarioEditor.Core/NuclearOption.ScenarioEditor.Core.csproj" />
    <Content Include="README.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="overrides.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="merged-units.json" CopyToOutputDirectory="PreserveNewest" Watch="false" />
    <Watch Include="**/*.xaml" Exclude="bin/**;obj/**" />
    <Watch Include="../NuclearOption.ScenarioEditor.Core/data.json" />
    <Watch Remove="overrides.json" />
    <Watch Remove="merged-units.json" />
    <Content Update="overrides.json" Watch="false" />
  </ItemGroup>
</Project>
