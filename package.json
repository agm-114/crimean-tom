{
  "name": "crimean-tom",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "test": "pnpm monitor:build && pnpm test:campaign && pnpm test:protocol",
    "test:ci": "pnpm monitor:build && dotnet restore CrimeanTom.CI.slnf && dotnet build CrimeanTom.CI.slnf --configuration Release --no-restore --verbosity minimal && dotnet test tests/CrimeanTom.Campaign.IntegrationTests/CrimeanTom.Campaign.IntegrationTests.csproj --configuration Release --no-build --verbosity minimal",
    "test:campaign": "dotnet test tests/CrimeanTom.Campaign.IntegrationTests/CrimeanTom.Campaign.IntegrationTests.csproj --configuration Debug --artifacts-path .run/test-artifacts/campaign",
    "test:protocol": "dotnet test tests/CrimeanTom.Protocol.Tests/CrimeanTom.Protocol.Tests.csproj --configuration Debug --artifacts-path .run/test-artifacts/protocol",
    "build": "pnpm monitor:build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power.ps1 build",
    "monitor:build": "pnpm --filter @crimean-tom/campaign-monitor build",
    "monitor:dev": "pnpm --filter @crimean-tom/campaign-monitor dev",
    "campaign:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/campaign-service-watch.ps1",
    "campaign:server": "pnpm monitor:build && dotnet run --project src/CrimeanTom.Campaign.ServiceHost/CrimeanTom.Campaign.ServiceHost.csproj --configuration Debug",
    "campaign:dev": "concurrently --kill-others-on-fail --names SERVICE,MONITOR --prefix-colors cyan,green \"pnpm campaign:watch\" \"pnpm monitor:dev\"",
    "campaign:stress": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/campaign-stress.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power.ps1 deploy",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power.ps1 launch",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power.ps1 verify",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power.ps1 dev",
    "logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power.ps1 logs",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power.ps1 status",
    "companion:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 start",
    "companion:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 stop",
    "companion:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 status",
    "companion:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 health",
    "worker:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power-worker.ps1 start",
    "worker:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power-worker.ps1 stop",
    "worker:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power-worker.ps1 status",
    "worker:live-proof": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power-worker-live-proof.ps1",
    "worker:migration-proof": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power-worker-migration-proof.ps1",
    "worker:live-migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power-worker-live-migrate.ps1",
    "worker:divergence-sample": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sea-power-divergence-sample.ps1",
    "game:ping": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 ping",
    "game:capabilities": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 capabilities",
    "game:scene": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 scene",
    "game:world": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 world",
    "game:bubble-probe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tactical-bubble-probe.ps1",
    "game:coupling": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 coupling",
    "game:campaign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 campaign",
    "game:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 ui",
    "game:screenshot": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 screenshot",
    "game:colliders": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 colliders",
    "game:colliders:capture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 colliders-capture",
    "game:open-task-force-builder": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 open-task-force-builder",
    "game:control-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crimean-tom-control.ps1 test",
    "inventory:determinism": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/determinism-inventory.ps1",
    "decompile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/decompile-sea-power.ps1 game",
    "decompile:anchorchain": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/decompile-sea-power.ps1 anchorchain",
    "decompile:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/decompile-sea-power.ps1 all-managed"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
