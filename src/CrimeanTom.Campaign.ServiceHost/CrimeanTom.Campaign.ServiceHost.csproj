<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CrimeanTom.Campaign.ServiceHost</AssemblyName>
    <RootNamespace>CrimeanTom.Campaign.ServiceHost</RootNamespace>
    <DotNetWatchContentFiles>false</DotNetWatchContentFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrimeanTom.Campaign.Contracts\CrimeanTom.Campaign.Contracts.csproj" />
    <ProjectReference Include="..\CrimeanTom.Campaign.Service\CrimeanTom.Campaign.Service.csproj" />
    <ProjectReference Include="..\CrimeanTom.Campaign.Transport\CrimeanTom.Campaign.Transport.csproj" />
  </ItemGroup>

  <!-- Vite owns this generated tree during development. Watching its chunk churn
       makes dotnet watch rescan hundreds of static files and can overflow the
       Windows file watcher. The backend still serves the files normally. -->
</Project>
