<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CrimeanTom.Campaign.ServiceHost</AssemblyName>
    <RootNamespace>CrimeanTom.Campaign.ServiceHost</RootNamespace>
    <DotNetWatchContentFiles>false</DotNetWatchContentFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrimeanTom.Campaign.Contracts\CrimeanTom.Campaign.Contracts.csproj" />
    <ProjectReference Include="..\CrimeanTom.Campaign.Service\CrimeanTom.Campaign.Service.csproj" />
    <ProjectReference Include="..\CrimeanTom.Campaign.Transport\CrimeanTom.Campaign.Transport.csproj" />
    <ProjectReference Include="..\CrimeanTom.Contracts\CrimeanTom.Contracts.csproj" />
    <ProjectReference Include="..\CrimeanTom.LoadAcceleration\CrimeanTom.LoadAcceleration.csproj" />
    <ProjectReference Include="..\CrimeanTom.Campaign.OperationalWorker\CrimeanTom.Campaign.OperationalWorker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyOperationalWorker" AfterTargets="Build">
    <PropertyGroup>
      <_OperationalWorkerOutput>$(MSBuildThisFileDirectory)..\CrimeanTom.Campaign.OperationalWorker\bin\$(Configuration)\$(TargetFramework)\</_OperationalWorkerOutput>
    </PropertyGroup>
    <ItemGroup>
      <_OperationalWorkerFiles Include="$(_OperationalWorkerOutput)**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_OperationalWorkerFiles)"
      DestinationFolder="$(OutputPath)operational-worker\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- Vite owns this generated tree during development. DotNetWatchContentFiles
       keeps generated chunks out of the watched MSBuild input; Vite also updates
       production assets in place so Roslyn never observes a delete/recreate storm.
       The backend still serves the files normally. -->
</Project>
