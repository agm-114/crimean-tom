<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SeaPowerDir Condition="'$(SeaPowerDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sea Power</SeaPowerDir>
    <AnchorChainDll Condition="'$(AnchorChainDll)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\1286220\3380210757\AnchorChain.dll</AnchorChainDll>
    <PluginDeployDirectory>$(SeaPowerDir)\Sea Power_Data\StreamingAssets\FlightDeckTweaks</PluginDeployDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AnchorChain">
      <HintPath>$(AnchorChainDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureAnchorChainReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AnchorChainDll)')"
           Text="AnchorChain.dll was not found. Set AnchorChainDll to the installed assembly." />
  </Target>

  <Target Name="DeployToSeaPower" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(DeployToGame)' == 'true'">
    <Error Condition="!Exists('$(SeaPowerDir)\Sea Power.exe')"
           Text="Sea Power was not found. Set SeaPowerDir to the folder containing Sea Power.exe." />
    <MakeDir Directories="$(PluginDeployDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDirectory)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed Flight Deck Tweaks to $(PluginDeployDirectory)" />
  </Target>
</Project>
