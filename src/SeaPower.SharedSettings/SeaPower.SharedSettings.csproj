<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>agm-114</Authors>
    <Description>Source package for Sea Power mod settings and Gameplay tabs.</Description>
    <RepositoryUrl>https://github.com/agm-114/crimean-tom</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SeaPower.SharedUi/SeaPower.SharedUi.csproj" />
    <None Include="*.cs" Pack="true" PackagePath="build/" />
    <None Update="SeaPower.SharedSettings.props" Pack="true" PackagePath="build/" />
    <None Include="../SeaPower.SharedUi/_._" Pack="true" PackagePath="lib/$(TargetFramework)/" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
