<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CrimeanTom.SeaPower</AssemblyName>
    <RootNamespace>CrimeanTom.SeaPower</RootNamespace>
    <Version>0.3.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <PluginDeployDirectory>$(SeaPowerDir)\Sea Power_Data\StreamingAssets\CrimeanTomOperations</PluginDeployDirectory>
    <CampaignDeployDirectory>$(SeaPowerDir)\Sea Power_Data\StreamingAssets\user\campaigns\crimean-tom-operations</CampaignDeployDirectory>
    <CampaignContentDirectory>$(MSBuildProjectDirectory)\..\..\content\campaigns\crimean-tom-operations</CampaignContentDirectory>
    <CampaignDescriptor>$(CampaignContentDirectory)\campaign.ini</CampaignDescriptor>
    <CampaignRoster>$(CampaignContentDirectory)\player_task_force_roster.ini</CampaignRoster>
    <CampaignArtDirectory>$(CampaignContentDirectory)\art</CampaignArtDirectory>
    <CampaignMissionDirectory>$(CampaignContentDirectory)\missions</CampaignMissionDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AnchorChain">
      <HintPath>$(AnchorChainDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SeaPowerDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Seapower-Scripts">
      <HintPath>$(GameManaged)\Seapower-Scripts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assets">
      <HintPath>$(GameManaged)\Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(GameManaged)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Noesis.NoesisGUI">
      <HintPath>$(GameManaged)\Noesis.NoesisGUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureSeaPowerReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManaged)\UnityEngine.CoreModule.dll')"
           Text="Sea Power assemblies were not found. Set SeaPowerDir to the folder containing Sea Power.exe." />
    <Error Condition="!Exists('$(AnchorChainDll)')"
           Text="AnchorChain.dll was not found. Set AnchorChainDll to the installed assembly." />
    <Error Condition="!Exists('$(SeaPowerDir)\BepInEx\core\0Harmony.dll')"
           Text="Harmony was not found in the Sea Power BepInEx installation." />
  </Target>

  <Target Name="DeployToSeaPower" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(DeployToGame)' == 'true'">
    <ItemGroup>
      <_PluginFile Include="$(TargetPath)" />
      <_PluginFile Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <_CampaignArt Include="$(CampaignArtDirectory)\**\*.*" />
      <_CampaignMission Include="$(CampaignMissionDirectory)\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(PluginDeployDirectory)" />
    <MakeDir Directories="$(CampaignDeployDirectory)" />
    <Copy SourceFiles="@(_PluginFile)" DestinationFolder="$(PluginDeployDirectory)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\_info.ini" DestinationFolder="$(PluginDeployDirectory)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(CampaignDescriptor)" DestinationFolder="$(CampaignDeployDirectory)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(CampaignRoster)" DestinationFolder="$(CampaignDeployDirectory)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CampaignArt)"
          DestinationFiles="@(_CampaignArt->'$(CampaignDeployDirectory)\art\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CampaignMission)"
          DestinationFiles="@(_CampaignMission->'$(CampaignDeployDirectory)\missions\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed Crimean Tom Operations to $(PluginDeployDirectory)" />
  </Target>
</Project>
